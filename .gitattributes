# docker-entrypoint.sh must keep LF endings. Development happens on Windows; a
# contributor with core.autocrlf=true would otherwise check the script out with
# CRLF, and the image then fails to start with an opaque
# "exec /usr/local/bin/docker-entrypoint.sh: no such file or directory" --
# the shell is looking for an interpreter named "/bin/sh\r".
*.sh text eol=lf
Dockerfile text eol=lf

# web-dev/ is frozen byte for byte (tests/test_dev_frontend.py pins its hashes),
# so no line-ending conversion on checkout.
web-dev/** -text
