# 02:15 UTC: after the evening ETL ticks, before anyone is likely to deploy.
# pg_dump holds ACCESS SHARE on every table for its whole run, so a deploy whose
# migration needs ACCESS EXCLUSIVE in that window fails at lock_timeout and is
# retried on a later autodeploy tick (docs/DEPLOY.md, "Backups").

[Unit]
Description=Nightly safety database backup

[Timer]
OnCalendar=*-*-* 02:15:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
