# Hourly convergence run for one instance (safety-ops@.service): loads a city
# that has never been loaded, rebuilds gold after a release, and deletes
# incidents that have aged past the one rolling year a city keeps (the `retain`
# step). With nothing to do a run is a handful of EXISTS queries.
#
# Not enabled by install-deployer.sh: the six-hourly incremental prunes too.
# Turn it on per instance where convergence between deploys is wanted:
#   sudo systemctl enable --now safety-ops@dev.timer

[Unit]
Description=Hourly safety data convergence (%i)

[Timer]
OnCalendar=*-*-* *:20:00 UTC
Persistent=false
RandomizedDelaySec=300
Unit=safety-ops@%i.service

[Install]
WantedBy=timers.target
