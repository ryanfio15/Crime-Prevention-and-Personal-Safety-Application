[Unit]
Description=Daily safety time-of-day rebuild (%i)

[Timer]
# 04:00 UTC daily for prod; dev's drop-in moves it to 06:00. Daily because the
# map is coloured by these layers (each city at its hour and weekday now).
OnCalendar=*-*-* 04:00:00
Persistent=true
Unit=safety-etl-hourly@%i.service

[Install]
WantedBy=timers.target
