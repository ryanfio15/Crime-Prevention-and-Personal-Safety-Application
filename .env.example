# Copy to .env and adjust. Defaults match docker-compose.yml.
#
# Each home-server instance has its own copy as I/.env, outside the release
# trees (docs/DEPLOYMENT.md); a container host would supply these as variables.
POSTGRES_DB=safety
POSTGRES_USER=safety
# Required, no default: pick a long random value (openssl rand -hex 32).
# docker compose refuses to start without it, and so does the app.
POSTGRES_PASSWORD=
# 127.0.0.1, not "localhost": docker-compose.yml publishes the database on the
# IPv4 loopback only, and "localhost" resolves to ::1 first on most systems.
# (A hosted deployment sets this to the platform's internal database hostname.)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Home server only: the loopback port safety-api@<instance> listens on
# (deploy/systemd/safety-api@.service). 8000 for prod, 8001 for dev; it must
# match the candidate ports in deploy/lib/install.sh and the nginx upstreams.
# Local development ignores it.
API_PORT=8000

# Local stand-in for the S3-compatible bronze bucket (design doc S9.2).
BRONZE_ROOT=./data/bronze

# How far back the Phase 1 backfill reaches (design doc S15 open question,
# resolved to a trailing 24-month window).
BACKFILL_MONTHS=24

# Serve /docs, /redoc and /openapi.json. Set false to take the interactive
# docs off a publicly reachable deployment.
ENABLE_DOCS=true

# Per-client request limiting (safety/api/ratelimit.py). Leave on anywhere
# reachable from the internet; false is for local development and for load
# testing your own instance.
ENABLE_RATE_LIMIT=true

# Optional Socrata application token, used by the four Socrata sources (Chicago,
# Seattle, Los Angeles, Austin). Not a credential -- it moves requests off the
# shared anonymous per-IP quota onto a per-token one, which matters when
# backfilling 24 months across four cities. Everything works without it.
# Register at https://evergreen.data.socrata.com/signup
SOCRATA_APP_TOKEN=

# Serving-layer cache bounds (safety/api/main.py). Sized for six cities; the byte
# budget is the one that actually protects the container, since a single
# whole-city layer at H3 resolution 10 runs from ~14 MB upward.
CACHE_MAX_ENTRIES=192
CACHE_MAX_BYTES=268435456

# --- ops convergence (safety/ops.py) ----------------------------------------
#
# `python -m safety.ops` works out what each enabled city is missing and runs
# only that. None of these is normally set; they exist so a scheduler with a
# fixed command line can still be steered, with anything an operator needs to
# vary reachable as a variable.
#
# Print the plan and the commands it would run, then exit.
OPS_DRY_RUN=false
# Converge one city instead of every enabled one. Empty means all.
OPS_CITY=
# Run every planned step regardless of what etl.ops_run says about recent
# failures. The escape hatch for "the portal is back up now, go".
OPS_FORCE=false
# How long a failed step is left alone before it is retried. Exists because the
# hosted ops service redeploys on every push, and without a cooldown a city
# whose portal is down would get a fresh 24-month backfill attempt each time.
OPS_RETRY_COOLDOWN_HOURS=6
# How long one run spends loading city history before it stops starting new
# slices, so the six-hourly pull and deploys never wait long for the ETL lock
# (docs/OPERATIONS.md, "Loading a city's full history").
OPS_HISTORY_MINUTES=25

# --- time windows (safety/etl/gold.py, migration 018) ------------------------
#
# Fallback if the long windows do not fit the disk: windows longer than this
# many years keep their counts but are built without the safety ranking.
# Leave it commented out to rank every window (an empty value does not parse).
# SAFETY_MAX_WINDOW_YEARS=2

# --- records withdrawn upstream (safety/etl/withdrawn.py, F13) ---------------
#
# Each incremental compares its revision window with silver. One of:
#   off     do nothing
#   report  record what is missing upstream as a withdrawn_upstream issue (default)
#   delete  also delete it, behind an outage guard, archiving every row to
#           etl.withdrawn_incident (restore SQL in docs/DEPLOYMENT.md)
# Empty means report; an unknown value means report, with a warning. Prod stays
# report until deletion is deliberately enabled there.
WITHDRAWN_RECONCILE=
# Days a deleted row stays in etl.withdrawn_incident for exact recovery.
WITHDRAWN_RETENTION_DAYS=90
