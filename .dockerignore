# Keep the build context small and the image free of host-specific artefacts.
#
# Careful here: db/migrations, reference/crosswalk and web/ must NOT be excluded
# -- safety/config.py resolves all three from the repo root at runtime, and an
# over-broad rule here produces an image that builds cleanly and then fails on
# the first request. `docker run --rm <image> python -c "from safety.config
# import WEB_DIR, MIGRATIONS_DIR, CROSSWALK_DIR; print(WEB_DIR.exists(),
# MIGRATIONS_DIR.exists(), CROSSWALK_DIR.exists())"` is the check.

.venv/
__pycache__/
*.pyc
*.pyo

# Bronze snapshots: 25 MB of gzipped pulls, regenerated by the ETL. The design
# doc (S9.2) puts these in object storage, not in an image.
data/

.git/
.gitignore
.idea/

# Never bake secrets into an image. The platform injects these as variables.
.env

Dockerfile
.dockerignore
docker-compose.yml
