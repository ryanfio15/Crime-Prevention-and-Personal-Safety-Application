# What `railway up` (deploy/railway/up.sh) leaves out of the upload. It already
# skips what .gitignore lists; these are the large or private things .gitignore
# does not cover. Same syntax as .gitignore.
#
# Careful: db/migrations, reference/crosswalk and web/ must stay in -- the
# image reads all three at runtime (see .dockerignore).

# 1.2 GB of local backups, excluded from git through .git/info/exclude, which
# Railway does not read.
legacy-backups/

# Local data and environments.
data/
.venv/
.env
node_modules/

# This checkout's link to its Railway project.
deploy/railway/.project-id
deploy/railway/.template-project-id
deploy/railway/.template-draft.json
